{
  "name": "dsh-local-hanaccount",
  "version": "2.5.0",
  "description": "Access lock for DeepSeek Harness web profile (password, passkey, IP lists, Nginx)",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "scripts/set-password.mjs",
    "scripts/migrate-legacy-sessions.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/bundle.mjs --check && node --test",
    "test:official": "node scripts/probe-isolated-host.mjs",
    "test:attack": "node --test test/attack-sim.test.js",
    "simulate-attacks": "node scripts/simulate-attacks.mjs",
    "build": "node scripts/bundle.mjs"
  },
  "hanaccountCompatibility": {
    "adapterId": "dsh-capability-web-auth-v1",
    "mode": "capability-based",
    "connectionMethods": [
      "requestRejection",
      "authenticatedUrl",
      "authorizeIndex"
    ],
    "webServerMethods": [
      "register",
      "registerUpgrade",
      "registerFallback"
    ],
    "webServerStructure": "writable exact/prefixes/upgrades Maps and supported fallback property",
    "optionalRpcIdentity": "admit plus browserPeer (rc.2) or legacy operator",
    "nativeRedirects": [
      "/",
      "./"
    ],
    "historicalAuditedOfficialCommit": "0a15e36e7f82b6ed45af6fa9759f29b40dcd965d",
    "publicDeploymentVerified": false
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "gate",
    "access-control",
    "security"
  ],
  "author": "han0423",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Z-6354/dsh-local-hanaccount.git"
  },
  "bugs": {
    "url": "https://github.com/Z-6354/dsh-local-hanaccount/issues"
  },
  "homepage": "https://github.com/Z-6354/dsh-local-hanaccount#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2"
  }
}
