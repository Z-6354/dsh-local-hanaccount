{
  "name": "dsh-local-hanaccount",
  "version": "0.1.1",
  "description": "Local account and account-scoped workspace gate for DeepSeek Harness web profile",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "hanaccount",
    "workspace"
  ],
  "author": "han0423",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Z-6354/dsh-local-hanaccount.git"
  },
  "bugs": {
    "url": "https://github.com/Z-6354/dsh-local-hanaccount/issues"
  },
  "homepage": "https://github.com/Z-6354/dsh-local-hanaccount#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}